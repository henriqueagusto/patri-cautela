# Copie para server/.env e ajuste.
# No notebook-servidor NÃO copie à mão: rode `npm run configurar`, que gera
# este arquivo com senha e segredo aleatórios (veja docs/SERVIDOR-LOCAL.md).

DATABASE_URL="postgresql://patri:patri@127.0.0.1:5432/patri?schema=public"
JWT_SECRET="troque-este-valor-em-producao"

# Porta e interface. 0.0.0.0 = aceita os outros aparelhos da rede.
PORT=3333
HOST=0.0.0.0

# Origens de OUTRO endereço autorizadas no navegador. Só para desenvolvimento
# (npm run dev) ou frontend hospedado separado. No servidor local não precisa.
CORS_ORIGIN="http://localhost:5173"

# Servidor único (notebook): o backend entrega também as telas compiladas.
# Deixe comentado no desenvolvimento.
# FRONTEND_DIR=../dist

# Pasta das fotos (relativa a server/ ou absoluta). No notebook, fora do código:
# UPLOAD_DIR=C:/PATRI-dados/uploads
# BACKUP_DIR=C:/PATRI-dados/backups
# LOG_DIR=C:/PATRI-dados/logs
# BACKUP_MANTER=14
# BACKUP_HORA=12

# Marca o banco desta máquina como o de verdade: bloqueia `db:zerar-local`.
# PATRI_PRODUCAO=sim

# Só na primeira carga (npm run setup / db:seed), se não houver usuário:
# ADMIN_EMAIL="admin@patri.local"
# ADMIN_SENHA="patri123"
